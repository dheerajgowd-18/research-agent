# Search Provider
TAVILY_API_KEY=

# LLM Configuration
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0

# Optional LangSmith Tracing (Supported: LANGSMITH_* or LANGCHAIN_*)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=verified-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Backward-compatible aliases:
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=verified-research-agent
